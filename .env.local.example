# ==============================================================================
# LearnOS AI — Server-Side AI Provider Configuration (100% Free Tiers Only)
# ==============================================================================
# Multi-provider fallback architecture:
# Gemini Free -> Groq Free -> Cerebras Free -> Local Deterministic Baseline
# All keys remain strictly server-side. Never use NEXT_PUBLIC_* prefixes.
# No paid APIs, paid subscriptions, or credit cards are ever required.

# 1. Google Gemini (Free Tier via Google AI Studio)
# https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq Cloud (Free Developer Tier with ultra-fast inference)
# https://console.groq.com/keys
GROQ_API_KEY=

# 3. Cerebras Cloud (Free Developer Tier for open models)
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Optional: Provider priority order (comma-separated, default: gemini,groq,cerebras)
AI_PROVIDER_ORDER=gemini,groq,cerebras

# Planned Google OAuth configuration (inactive until the Auth.js integration is added)
# AUTH_SECRET=generate-a-long-random-secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
